# ── Supabase (customer accounts, orders) ──
#
# These two are public by design — they are shipped to the browser and
# every write they can make is constrained by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Inventory Core ──
#
# Server-side only. A key here can hold and consume real stock, so it
# must never carry a NEXT_PUBLIC_ prefix — that publishes it to the
# internet.
INVENTORY_API_URL=http://localhost:3100
INVENTORY_API_KEY=ic_live_...

# ── Logistics Core ──
#
# Where a placed order is handed over for delivery. Without these the
# order is still created and the stock still held; it simply never
# reaches the delivery system, and `republishMissedOrders` can send it
# later.
LOGISTICS_API_URL=http://localhost:3200
# Scope: orders:ingest
#   on the logistics deployment: npm run key:mint -- "Grocery storefront" orders:ingest
LOGISTICS_API_KEY=lg_live_...
# Must match INBOUND_WEBHOOK_SECRET on the logistics side. The request
# is signed over `<unix seconds>.<body>`, so a captured one expires.
LOGISTICS_WEBHOOK_SECRET=

# ── Supabase service role ──
#
# Used by exactly two statements: reading an order back before it is
# published to logistics, and writing the returned tracking id.
#
# It bypasses row-level security entirely. Server-side only, never
# committed, never NEXT_PUBLIC_. Reading the order back is the point —
# it means logistics receives what is STORED rather than what a
# browser claimed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
