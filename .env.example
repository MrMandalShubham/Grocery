# ── Supabase (customer accounts, orders) ──
#
# These two are public by design — they are shipped to the browser and
# every write they can make is constrained by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Inventory Core ──
#
# Server-side only. A key here can hold and consume real stock, so it
# must never carry a NEXT_PUBLIC_ prefix — that publishes it to the
# internet.
INVENTORY_API_URL=http://localhost:3100
INVENTORY_API_KEY=ic_live_...

# ── Receiving stock events FROM Inventory ──
#
# POST /api/inventory/events verifies `t=<unix>,v1=<hmac over t.body>`
# with this secret. It must equal the `signing_secret` on Inventory's
# platform.webhook_subscription row that points at this deployment:
#
#   select url, signing_secret from platform.webhook_subscription
#    where event = 'stock.changed';
#
# Without it the endpoint refuses every delivery with a 401, which
# looks identical to a wrong secret from Inventory's side — so the log
# line says `not_configured` explicitly to tell the two apart.
#
# A THIRD secret, separate from both logistics ones. One per direction
# per peer: a leak of any cannot be used elsewhere, and any can be
# rotated alone.
INVENTORY_WEBHOOK_SECRET=

# ── Logistics Core ──
#
# Where a placed order is handed over for delivery. Without these the
# order is still created and the stock still held; it simply never
# reaches the delivery system, and `republishMissedOrders` can send it
# later.
LOGISTICS_API_URL=http://localhost:3200
# Scope: orders:ingest
#   on the logistics deployment: npm run key:mint -- "Grocery storefront" orders:ingest
LOGISTICS_API_KEY=lg_live_...
# Must match INBOUND_WEBHOOK_SECRET on the logistics side. The request
# is signed over `<unix seconds>.<body>`, so a captured one expires.
LOGISTICS_WEBHOOK_SECRET=

# ── Supabase service role ──
#
# Used by exactly two statements: reading an order back before it is
# published to logistics, and writing the returned tracking id.
#
# It bypasses row-level security entirely. Server-side only, never
# committed, never NEXT_PUBLIC_. Reading the order back is the point —
# it means logistics receives what is STORED rather than what a
# browser claimed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Receiving delivery status FROM Logistics ──
#
# POST /api/logistics/status verifies `t=<unix>,v1=<hmac over t.body>`
# with this secret. It must equal GROCERY_WEBHOOK_SECRET on the
# logistics deployment — a mismatch shows up there as a 401 and a
# dead-lettered status, and here in the log as "signature does not
# match".
#
# Deliberately NOT the same variable as LOGISTICS_WEBHOOK_SECRET
# above, which signs traffic going the other way. One secret per
# direction means a leaked receiver secret cannot be used to place
# orders, and rotating one does not take the other down.
LOGISTICS_INBOUND_SECRET=
